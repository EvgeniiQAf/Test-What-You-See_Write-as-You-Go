{
  "manifest_version": 3,
  "name": "Browser GPT Testmo Helper",
  "version": "1.0.0",
  "description": "Select page elements and generate Testmo test cases",
  "permissions": ["activeTab", "scripting", "tabs", "downloads", "storage"],
"host_permissions": [
  "<all_urls>"
],
  "action": {
    "default_title": "Open TWYS QA Helper"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/state.js",
        "src/utils.js",
        "src/storage.js",
        "src/ui-templates.js",
        "src/ui-manager.js",
        "src/screenshot-manager.js",
        "src/backend-client.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "commands": {
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Toggle extension panel"
    },
    "quick-screenshot": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Quick screenshot active tab"
    }
  }
}